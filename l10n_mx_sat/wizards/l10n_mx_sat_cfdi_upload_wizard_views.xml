<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="l10n_mx_sat_cfdi_upload_wizard_view_form" model="ir.ui.view">
        <field name="name">l10n_mx_sat.cfdi.upload.wizard.form</field>
        <field name="model">l10n_mx_sat.cfdi.upload.wizard</field>
        <field name="arch" type="xml">
            <form string="Upload CFDI">
                <group>
                    <field
                        name="company_id"
                        groups="base.group_multi_company"
                    />
                    <field name="upload_file" filename="upload_filename" />
                    <field name="upload_filename" invisible="1" />
                </group>
                <footer>
                    <button
                        name="action_upload"
                        type="object"
                        string="Upload"
                        class="btn-primary"
                    />
                    <button string="Cancel" special="cancel" class="btn-secondary" />
                </footer>
            </form>
        </field>
    </record>

    <record id="l10n_mx_sat_cfdi_upload_wizard_action" model="ir.actions.act_window">
        <field name="name">Upload CFDI</field>
        <field name="res_model">l10n_mx_sat.cfdi.upload.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
